generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Season {
  all
  summer
  winter
  spring
  autumn
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  createdAt      DateTime @default(now())

  // Champs pour freemium & IA
  aiTokens       Int      @default(1) // 1 token au départ
  lastTokenReset DateTime @default(now()) // quand on a donné le dernier token gratuit
  isPremium      Boolean  @default(false)
  subscriptionEnd DateTime? // null si free
}


model ClothingItem {
  id              String   @id @default(uuid())
  userId          String
  type            String
  brand           String?
  color           String
  secondaryColor  String?
  style           String
  imageUrl        String
  season          Season?
  createdAt       DateTime @default(now())
}

model Preference {
  id              String   @id @default(uuid())
  userId          String   @unique
  favoriteColors  String[]
  avoidColors     String[]
  favoriteStyles  String[]
  avoidTypes      String[]
  createdAt       DateTime @default(now())
}

model Outfit {
  id          String   @id @default(uuid())
  userId      String
  clothingIds String[]
  name        String?
  createdAt   DateTime @default(now())
}

